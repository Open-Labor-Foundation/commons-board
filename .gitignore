# Dependencies
node_modules/

# Build output
dist/
build/
.next/
apps/web/.next/

# Environment
.env
*.env

# Runtime data
.data/
.ai/

# Logs
*.log

# macOS
.DS_Store

# Editor
.vscode/
.idea/

# TS build info
*.tsbuildinfo

# Add-in runtime state (created by CB at runtime, not source-controlled)
/addins/
# Staged copy of installed packs' page components, regenerated by
# scripts/generate-addin-page-registry.mjs each build so Next's webpack
# bundler can resolve them from inside the app's own module root.
/apps/web/addins/

# Test artifacts
test-results/
apps/web/test-results/
apps/web/playwright-report/

# Compiled output that lands alongside source (tsc without outDir)
packages/shared/src/**/*.js
packages/shared/src/**/*.js.map
packages/shared/src/**/*.d.ts
packages/shared/src/**/*.d.ts.map
services/api/src/**/*.js
services/api/src/**/*.js.map
services/api/src/**/*.d.ts
services/api/src/**/*.d.ts.map
